{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: Build Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Firmware: Flash Debug (external 3.3V)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/flash.ps1"],
      "dependsOn": "Firmware: Build Debug",
      "problemMatcher": []
    }
  ]
}
