{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32G070: ST-Link Debug",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "deviceName": "STM32G070CBT6",
      "deviceCore": "Cortex-M0+",
      "runEntry": "main",
      "preLaunchTask": "Firmware: Build Debug",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/Debug/epaper_NFC.elf",
          "symbolFileName": "${workspaceFolder}/build/Debug/epaper_NFC.elf"
        }
      ],
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "140",
      "serverReset": "Software system reset"
    }
  ]
}
